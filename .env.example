# Copy to .env. Used by docker compose and by local runs (backend/config.py reads .env).

# --- database ---------------------------------------------------------------------------
# docker compose builds DATABASE_URL from these three; set a strong password.
POSTGRES_USER=midmoe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=midmoe
# Local runs without Docker use SQLite (ignored by docker compose):
DATABASE_URL=sqlite:///./midmoe.db

# --- LLM assistant ----------------------------------------------------------------------
# LLM_PROVIDER: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_API_KEY=
# empty = default model: gemini-flash-latest | gpt-4.1-mini | claude-opus-5-5
LLM_MODEL=

# --- app --------------------------------------------------------------------------------
ARTIFACT_DIR=artifacts/vn
TZ=Asia/Ho_Chi_Minh
# First day of the "live" period (2025 is the paper's test year). Also passed to the web build.
LIVE_START=2026-01-01

# --- public URLs (what the BROWSER uses) ------------------------------------------------
# Changing NEXT_PUBLIC_API_URL requires rebuilding the web image (it is inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated web origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
WEB_PORT=3000
